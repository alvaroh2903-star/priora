{
  "name": "priora",
  "version": "0.1.0",
  "description": "Priora SaaS — integração de e-mail do Outlook via Microsoft Graph API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register --test src/auditoria/preAlerta/*.test.ts",
    "db:migrate:demurrage": "ts-node src/demurrage-engine/db/migrate.ts",
    "test:demurrage-engine": "node --test-concurrency=1 -r ts-node/register --test src/demurrage-engine/__tests__/*.test.ts",
    "test:identidade": "node --test-concurrency=1 -r ts-node/register --test src/identidade/__tests__/*.test.ts",
    "test:liberacao": "node -r ts-node/register --test src/liberacao/dominio/__tests__/*.test.ts",
    "test:l1b": "node -r ts-node/register --test src/liberacao/dominio/__tests__/l1b/*.test.ts",
    "test:courier-fatos": "TS_NODE_PREFER_TS_EXTS=true node --test-concurrency=1 -r ts-node/register --test src/couriers/fatos/__tests__/*.test.ts",
    "test:auditoria-fatos": "TS_NODE_PREFER_TS_EXTS=true node --test-concurrency=1 -r ts-node/register --test src/auditoria/fatos/__tests__/*.test.ts",
    "test:s4": "TS_NODE_PREFER_TS_EXTS=true node --test-concurrency=1 -r ts-node/register --test src/auth/__tests__/*.test.ts",
    "test:l2": "TS_NODE_PREFER_TS_EXTS=true node --test-concurrency=1 -r ts-node/register --test src/liberacao/aplicacao/__tests__/l2.test.ts",
    "test:l4": "TS_NODE_PREFER_TS_EXTS=true node --test-concurrency=1 -r ts-node/register --test src/liberacao/aplicacao/__tests__/l4.test.ts",
    "test:l11a": "TS_NODE_PREFER_TS_EXTS=true node --test-concurrency=1 -r ts-node/register --test src/liberacao/aplicacao/__tests__/l11a.test.ts",
    "test:g3": "TS_NODE_PREFER_TS_EXTS=true node --test-concurrency=1 -r ts-node/register --test src/liberacao/aplicacao/__tests__/g3.test.ts"
  },
  "keywords": [
    "outlook",
    "microsoft-graph",
    "email",
    "saas"
  ],
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^2.13.1",
    "@google/genai": "^2.10.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3",
    "playwright": "1.56.1",
    "undici": "^8.10.0",
    "proxy-chain": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
