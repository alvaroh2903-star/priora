{
  "name": "priora",
  "version": "0.1.0",
  "description": "Priora SaaS — integração de e-mail do Outlook via Microsoft Graph API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register --test src/auditoria/preAlerta/*.test.ts",
    "browser:smoke": "ts-node src/browser/smoke.ts",
    "carriers:detect": "ts-node src/browser/carriers/detectCli.ts",
    "carriers:selftest": "ts-node src/browser/carriers/scrapers/hapagSelftest.ts",
    "cosco:selftest": "ts-node src/browser/carriers/scrapers/coscoSelftest.ts",
    "pil:selftest": "ts-node src/browser/carriers/scrapers/pilSelftest.ts",
    "oocl:selftest": "ts-node src/browser/carriers/scrapers/ooclSelftest.ts",
    "events:selftest": "ts-node src/browser/carriers/scrapers/demurrageEventsSelftest.ts",
    "demurrage:calc": "ts-node src/demurrage/calculatorSelftest.ts",
    "auth:selftest": "ts-node src/auth/accountSwitchSelftest.ts",
    "rocket:selftest": "ts-node src/rocket/rocketSelftest.ts"
  },
  "keywords": [
    "outlook",
    "microsoft-graph",
    "email",
    "saas"
  ],
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^2.13.1",
    "@google/genai": "^2.10.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "playwright": "1.56.1",
    "proxy-chain": "^3.0.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
