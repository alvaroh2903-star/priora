{
  "name": "priora",
  "version": "0.1.0",
  "description": "Priora SaaS — integração de e-mail do Outlook via Microsoft Graph API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
