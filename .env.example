# Porta do servidor
PORT=3000

# Segredo usado para assinar o cookie de sessão (use uma string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Credenciais do app registrado no Azure / Entra ID
# https://portal.azure.com -> Microsoft Entra ID -> App registrations
AZURE_CLIENT_ID=seu-application-client-id
AZURE_CLIENT_SECRET=seu-client-secret

# "common" aceita contas pessoais e corporativas.
# Use o Directory (tenant) ID para restringir a uma única organização.
AZURE_TENANT_ID=common

# Precisa ser idêntico ao Redirect URI cadastrado no Azure
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# Ative para ver logs detalhados do MSAL
MSAL_DEBUG=false

# --- IA (Google Gemini) ---
# Opcional: sem ela, ler/enviar e-mail funciona, mas a análise por IA fica off.
# Chave GRATUITA (sem cartão) em https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Modelo usado na análise (padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Palavras-chave para filtrar e-mails de logística (separadas por vírgula).
# Deixe em branco para usar a lista padrão do sistema.
LOGISTICS_KEYWORDS=

# --- Rastreio FedEx (opcional) ---
# Portal: https://developer.fedex.com -> suas credenciais (API Key + Secret Key)
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT=
# Sandbox: https://apis-sandbox.fedex.com  |  Produção: https://apis.fedex.com
FEDEX_BASE_URL=https://apis-sandbox.fedex.com

# --- Rastreio DHL (opcional) ---
# Portal: https://developer.dhl.com -> app com a "Shipment Tracking - Unified" API
# A API de tracking usa só a API Key (header DHL-API-Key). O secret é reservado.
DHL_API_KEY=
DHL_API_SECRET=
DHL_BASE_URL=https://api-eu.dhl.com

# --- Bot de Demurrage (Playwright) ---
# Base dos scrapers que buscam free time/datas/diárias direto nos portais dos
# armadores/terminais. Rode "npm run browser:smoke" para validar o navegador.
# headless=true em produção; false só para depurar localmente com tela.
BROWSER_HEADLESS=true
# Caminho explícito do Chromium (normalmente vazio: o Playwright resolve sozinho).
PLAYWRIGHT_CHROMIUM_PATH=
# Timeout padrão de navegação (ms).
BROWSER_NAV_TIMEOUT_MS=30000

# Proxy de saída (opcional, recomendado para não bater sempre do mesmo IP).
# server: http://host:porta ou socks5://host:porta
# Ex. IPRoyal (residencial): PROXY_SERVER=http://geo.iproyal.com:12321
#   e usuário/senha do painel. Dica: dá para forçar saída no Brasil anexando
#   "_country-br" à SENHA (ex.: PROXY_PASSWORD=suasenha_country-br).
# NUNCA commite os valores reais — preencha só no painel do Render.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Web Unblocker (opcional): proxy que fura anti-bot (Cloudflare etc.) e devolve o
# HTML liberado. Usado só nos portais protegidos (ex.: Hapag), pois é pago por
# requisição. É um proxy SEPARADO do residencial, com credenciais próprias.
# Ex. IPRoyal: WEB_UNBLOCKER_SERVER=http://unblocker.iproyal.com:12323
WEB_UNBLOCKER_SERVER=
WEB_UNBLOCKER_USERNAME=
WEB_UNBLOCKER_PASSWORD=

# Bright Data Web Unlocker (MODO API — fura Cloudflare interativo).
# Painel brightdata.com/cp: crie uma zona "Web Unlocker" (ex.: priora) e pegue a
# API key (rodapé do painel). Uso: POST api.brightdata.com/request.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=priora

# Bright Data SCRAPING BROWSER (navegador remoto real via CDP) — mais robusto que
# o Web Unlocker para SPAs pesadas (ex.: Hapag), pois pilotamos a página de
# verdade (renderiza JS, fura Cloudflare, aceita cookies, espera a tabela).
# Crie uma zona "Scraping Browser"/"Browser API" no painel e cole aqui o
# usuário:senha (o usuário é do tipo brd-customer-<id>-zone-<zona>). Rota de
# teste: /health/scrape-sb?token=<DIAG_TOKEN>&ref=<BL>
BRIGHTDATA_SB_AUTH=

# Cloud browser AGNÓSTICO (CDP por WebSocket) — troca de provedor sem mexer no
# código. Cole a URL wss:// COMPLETA de QUALQUER provedor que fale CDP:
# Browserbase, Steel.dev, Browserless, Oxylabs, self-hosted browserless, etc.
# Tem PRIORIDADE sobre o Bright Data (útil p/ A/B testar quem passa mais armadores
# sem a trava de robots.txt do Bright Data). Vazio = usa BRIGHTDATA_SB_AUTH.
# Ex.: wss://user:pass@connect.browserbase.com  |  wss://...@chrome.browserless.io
SCRAPE_BROWSER_WSS=

# Diagnóstico de scraping ao vivo SEM login (opcional). Se definido, liga a rota
# GET /health/scrape?ref=<BL>&token=<DIAG_TOKEN> para testar a raspagem num portal
# real em isolamento. Deixe vazio para manter a rota desligada.
DIAG_TOKEN=

# Resolução de CAPTCHA (usado nas próximas etapas quando um portal exigir).
# provider: anti-captcha | 2captcha
ANTICAPTCHA_PROVIDER=anti-captcha
ANTICAPTCHA_KEY=

# --- APIs OFICIAIS de rastreio dos armadores (fonte híbrida) ---
# Estratégia: scraping é o caminho primário; a API oficial entra como FALLBACK
# (onde o scraping não vence) ou como fonte PRINCIPAL quando o portal bloqueia
# scraping (ex.: Maersk = apiFirst). Maioria segue o padrão DCSA (um mapper serve p/ vários).
# Maersk (Track & Trace, header Consumer-Key). URL/header podem variar por conta —
# confirme no developer.maersk.com. Use {ref} na URL se o número for path param.
MAERSK_API_KEY=
MAERSK_TRACK_URL=https://api.maersk.com/track
MAERSK_AUTH_HEADER=Consumer-Key
# HMM (quando conseguir a chave) — preencha URL/header conforme a doc deles.
HMM_API_KEY=
HMM_TRACK_URL=
HMM_AUTH_HEADER=x-api-key

# Loop de rastreio (cache + paralelismo dos scrapers):
# - por quantas horas um resultado raspado é reaproveitado (evita re-raspar);
# - quantos scrapers rodam em paralelo (cuidado com OOM no Render free/512MB);
# - teto de BLs por chamada em lote (/enrich-batch).
BOT_RESULT_TTL_HOURS=12
BOT_CONCURRENCY=2
BOT_MAX_BATCH=10

# --- Supabase (multiusuário: contas Priora isoladas) ---
# Painel do Supabase → Project Settings → API. Sem isto, roda no modo MVP de
# conta Microsoft única (arquivos locais). A SERVICE ROLE KEY é SECRETA (só no
# servidor) — NUNCA exponha ao navegador nem commite.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Rocket / Head Cargo (sistema de gestão de importação) ---
# Fonte dos processos IMxxxx: fornece a data de descarga (início do demurrage) e
# o vínculo BL↔processo por API. Acesso emprestado — o scraping continua sendo o
# caminho próprio. API key + workspace são SECRETOS (só no servidor).
ROCKET_BASE_URL=https://myrocket.rocketlogistics.com.br
ROCKET_API_KEY=
ROCKET_WORKSPACE_ID=
