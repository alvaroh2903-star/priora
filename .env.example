# Porta do servidor
PORT=3000

# Segredo usado para assinar o cookie de sessão (use uma string longa e aleatória).
# Obrigatório em produção (o padrão de desenvolvimento é recusado no boot).
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Sessão humana (Produção P1): vida máxima desde o login, em dias (padrão 7), e
# ociosidade máxima entre requisições, em horas (padrão 12). Aplicadas no
# servidor (tabela sessoes_humanas, migration 0049).
# SESSION_MAX_AGE_DAYS=7
# SESSION_IDLE_HOURS=12

# Origens extras aceitas em escritas do navegador (lista separada por vírgula),
# além da própria origem da requisição — ex.: domínio próprio atrás de outro proxy.
# PRIORA_ORIGENS_PERMITIDAS=https://app.exemplo.com.br

# Credenciais do app registrado no Azure / Entra ID
# https://portal.azure.com -> Microsoft Entra ID -> App registrations
AZURE_CLIENT_ID=seu-application-client-id
AZURE_CLIENT_SECRET=seu-client-secret

# "common" aceita contas pessoais e corporativas.
# Use o Directory (tenant) ID para restringir a uma única organização.
AZURE_TENANT_ID=common

# Precisa ser idêntico ao Redirect URI cadastrado no Azure
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# Ative para ver logs detalhados do MSAL
MSAL_DEBUG=false

# --- IA (Google Gemini) ---
# Opcional: sem ela, ler/enviar e-mail funciona, mas a análise por IA fica off.
# Chave GRATUITA (sem cartão) em https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Modelo usado na análise (padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Palavras-chave para filtrar e-mails de logística (separadas por vírgula).
# Deixe em branco para usar a lista padrão do sistema.
LOGISTICS_KEYWORDS=

# --- Rastreio FedEx (opcional) ---
# Portal: https://developer.fedex.com -> suas credenciais (API Key + Secret Key)
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT=
# Sandbox: https://apis-sandbox.fedex.com  |  Produção: https://apis.fedex.com
FEDEX_BASE_URL=https://apis-sandbox.fedex.com

# --- Rastreio DHL (opcional) ---
# Portal: https://developer.dhl.com -> app com a "Shipment Tracking - Unified" API
# A API de tracking usa só a API Key (header DHL-API-Key). O secret é reservado.
DHL_API_KEY=
DHL_API_SECRET=
DHL_BASE_URL=https://api-eu.dhl.com

# --- Demurrage Engine V2 (src/demurrage-engine) ---
# PostgreSQL definitivo desde a Fase 1 (sem SQLite intermediário). Não usado
# pelo módulo Demurrage V1 (src/demurrage) nem por nenhuma outra parte da
# aplicação — só pelo novo motor em construção. Sem esta variável, apenas os
# testes/migrations do demurrage-engine ficam indisponíveis; o resto da
# Priora funciona normalmente.
# npm run db:migrate:demurrage   -> aplica as migrations
# npm run test:demurrage-engine  -> roda a suíte (usa DEMURRAGE_TEST_DATABASE_URL, se definida, senão esta)
DEMURRAGE_DATABASE_URL=
DEMURRAGE_TEST_DATABASE_URL=

# --- Handoff do Demurrage: controle de capacidade (POST /api/integracoes/demurrage/handoff/processos) ---
# Balde de fichas por credencial e por organização (somando todas as
# credenciais dela): POR_MINUTO é a taxa de reposição (média sustentada de
# tentativas autenticadas aceitas); RAJADA é quantas podem passar seguidas.
# Pior caso numa janela de 60 s = POR_MINUTO + RAJADA. Ausente = padrão abaixo.
# Se definida, precisa ser um inteiro positivo (1 a 1000000): valor vazio,
# zero, negativo ou não inteiro DERRUBA a inicialização — não existe "desligar".
# Por isso ficam comentadas: descomente só para trocar o padrão.
# PRIORA_HANDOFF_CAPACIDADE_CREDENCIAL_POR_MINUTO=60
# PRIORA_HANDOFF_CAPACIDADE_CREDENCIAL_RAJADA=10
# PRIORA_HANDOFF_CAPACIDADE_ORGANIZACAO_POR_MINUTO=120
# PRIORA_HANDOFF_CAPACIDADE_ORGANIZACAO_RAJADA=20
