{
  "version": "1.0.0",
  "module": "courier",
  "description": "Configuração centralizada dos filtros determinísticos usados para selecionar e classificar e-mails candidatos ao módulo Courier da Priora.",
  "normalization": {
    "lowercaseForMatching": true,
    "removeDiacritics": true,
    "collapseWhitespace": true,
    "stripHtmlForAnalysis": true,
    "preserveOriginalBody": true,
    "preserveLineBreaks": true,
    "preserveTables": true,
    "preserveSymbols": [
      "#",
      "/",
      "-",
      "_",
      ":"
    ],
    "trackingNormalization": {
      "removeSpaces": true,
      "removeHyphens": true,
      "digitsOnlyAfterCarrierDetection": true
    }
  },
  "graphScope": {
    "folders": [
      "inbox",
      "sentitems"
    ],
    "initialSyncDays": 90,
    "pageSize": 50,
    "properties": [
      "id",
      "internetMessageId",
      "conversationId",
      "subject",
      "body",
      "bodyPreview",
      "from",
      "sender",
      "toRecipients",
      "ccRecipients",
      "replyTo",
      "receivedDateTime",
      "sentDateTime",
      "lastModifiedDateTime",
      "hasAttachments",
      "importance",
      "isRead",
      "parentFolderId",
      "webLink"
    ],
    "attachmentMetadata": [
      "id",
      "name",
      "contentType",
      "size",
      "isInline"
    ]
  },
  "keywords": {
    "carriers": [
      "dhl",
      "fedex",
      "fed ex",
      "sedex"
    ],
    "futureCarriers": [
      "ups",
      "tnt",
      "ems",
      "aramex"
    ],
    "trackingTerms": [
      "tracking",
      "tracking number",
      "tracking no",
      "tracking no.",
      "tracking#",
      "tracking #",
      "courier number",
      "courier no",
      "courier no.",
      "courier#",
      "courier #",
      "awb",
      "air waybill",
      "waybill",
      "shipment number",
      "shipment no",
      "dhl#",
      "fedex#"
    ],
    "shipmentActionsConfirmed": [
      "sent",
      "sent out",
      "has been sent",
      "was sent",
      "already sent",
      "posted",
      "has been posted",
      "couriered",
      "has been couriered",
      "dispatched",
      "has been dispatched",
      "mailed",
      "shipped",
      "delivered to courier",
      "has send",
      "was send",
      "has posted"
    ],
    "shipmentActionsPlanned": [
      "preparing to send",
      "preparing to sent",
      "will send",
      "will arrange",
      "can we arrange to send",
      "planning to send",
      "ready to send",
      "waiting to send",
      "arranged to send",
      "arranged courier"
    ],
    "pouchTerms": [
      "courier",
      "pouch",
      "pouch list",
      "document pouch",
      "docs pouch",
      "document envelope",
      "envelope",
      "original docs",
      "original documents",
      "shipping documents",
      "shipping docs",
      "document list",
      "documents list",
      "below doc",
      "below docs",
      "attached pouch list",
      "attach picture",
      "attached picture"
    ],
    "omblExplicit": [
      "ombl",
      "original mbl",
      "original master bl",
      "original master b/l",
      "original master bill",
      "original master bill of lading",
      "master original",
      "master bl original",
      "master b/l original"
    ],
    "ohblExplicit": [
      "ohbl",
      "original hbl",
      "original house bl",
      "original house b/l",
      "original house bill",
      "original house bill of lading",
      "house original",
      "hbl original"
    ],
    "otherDocuments": [
      "invoice",
      "commercial invoice",
      "packing list",
      "fumigation certificate",
      "fumigation",
      "certificate of origin",
      "origin certificate",
      "coo",
      "insurance certificate",
      "insurance policy",
      "debit note",
      "credit note"
    ],
    "telexRelease": [
      "telex release",
      "telex released",
      "released by telex",
      "hbl telex",
      "hbl telex release",
      "express release",
      "express released",
      "surrendered",
      "surrendered hbl",
      "hbl surrendered"
    ],
    "hblSentToCustomer": [
      "hbl sent to consignee",
      "ohbl sent to consignee",
      "original hbl sent to consignee",
      "hbl sent directly to consignee",
      "hbl sent to customer",
      "hbl sent directly to customer",
      "hbl sent to importer",
      "hbl couriered to consignee",
      "hbl delivered to consignee",
      "shipper will send hbl to consignee",
      "collect ohbl from cnee",
      "collect hbl from consignee"
    ],
    "hblSentToRocket": [
      "ohbl sent to your office",
      "original hbl sent to your office",
      "hbl couriered to rocket",
      "hbl included in the pouch",
      "ohbl enclosed",
      "original house bl enclosed"
    ],
    "waveBl": [
      "wave bl",
      "wave b/l",
      "wave bill",
      "electronic wave bl",
      "digital wave bl"
    ],
    "destinationIssuance": [
      "issue at destination",
      "issued at destination",
      "destination issuance",
      "print at destination",
      "printed at destination",
      "release at destination",
      "destination release",
      "original issued at destination",
      "mbl issued at destination"
    ],
    "problemTerms": [
      "lost",
      "missing",
      "not found",
      "not enclosed",
      "not included",
      "forgot",
      "forgotten",
      "damaged",
      "torn",
      "destroyed",
      "opened",
      "violated",
      "wet",
      "delayed",
      "delay",
      "stuck",
      "held",
      "on hold",
      "exception",
      "shipment exception",
      "customs delay",
      "delivery exception",
      "failed delivery",
      "address issue",
      "payment pending",
      "awaiting payment",
      "waiting payment",
      "local charges pending",
      "cannot send",
      "not ready",
      "still waiting",
      "returned",
      "return to carrier",
      "reissue",
      "reissuance",
      "second original",
      "security copy",
      "backup original",
      "spare original"
    ],
    "weakNoiseTerms": [
      "rate",
      "quotation",
      "freight rate",
      "schedule",
      "invoice payment",
      "demurrage",
      "arrival notice",
      "booking confirmation",
      "manifest",
      "shipping instruction",
      "draft approval",
      "pre-alert"
    ]
  },
  "regex": {
    "rocketProcess": "\\bIM\\s*[-:]?\\s*\\d{3,6}(?:-\\d{2})?\\b",
    "containerIso": "\\b[A-Z]{4}\\d{7}\\b",
    "carrierNearTracking": "\\b(DHL|FEDEX|FED\\s*EX|SEDEX)\\b[^\\r\\n]{0,30}?([0-9][0-9\\s-]{7,24}[0-9])\\b",
    "trackingTermNearNumber": "\\b(?:TRACKING(?:\\s*(?:NUMBER|NO\\.?|#))?|COURIER(?:\\s*(?:NUMBER|NO\\.?|#))?|AWB|AIR\\s+WAYBILL|WAYBILL|SHIPMENT(?:\\s*(?:NUMBER|NO\\.?|#))?)\\b[^\\r\\n]{0,30}?([0-9][0-9\\s-]{7,24}[0-9])\\b",
    "bookingLabel": "\\bBOOKING\\s*(?:NUMBER|NO\\.?|#)?\\s*[:#-]?\\s*([A-Z0-9][A-Z0-9._/-]{4,30})\\b",
    "etaLabel": "\\b(?:ETA|EXPECTED\\s+ARRIVAL|ARRIVAL)\\s*[:#-]?\\s*([^\\r\\n]{3,30})"
  },
  "scoring": {
    "carrierFound": 3,
    "validTrackingFound": 6,
    "trackingTermFound": 3,
    "omblExplicitFound": 5,
    "ohblExplicitFound": 5,
    "rocketProcessFound": 4,
    "multipleReferencesTable": 5,
    "courierHashFound": 5,
    "pouchTermFound": 3,
    "originalDocumentTermFound": 2,
    "confirmedShipmentActionFound": 3,
    "plannedShipmentActionFound": 1,
    "problemTermFound": 3,
    "telexReleaseFound": 2,
    "waveBlFound": 2,
    "destinationIssuanceFound": 2,
    "noiseOnlyPenalty": -4,
    "thresholds": {
      "ignoreBelow": 6,
      "possibleCourierFrom": 6,
      "highProbabilityFrom": 13
    }
  },
  "hardRules": {
    "sameNormalizedTrackingMeansSameCourier": true,
    "carrierWithoutTrackingIsNotEnough": true,
    "trackingWithoutContextGoesToReview": true,
    "hblNumberDoesNotImplyPhysicalOhbl": true,
    "mblNumberDoesNotAutomaticallyImplyPhysicalOmbl": true,
    "plannedShipmentDoesNotEqualSent": true,
    "preAlertAloneDoesNotCreateCourier": true,
    "physicalReceiptRequiresHumanOrCarrierConfirmation": true,
    "allConclusionsRequireEvidence": true
  }
}
